# Copy to .env for local dev. In production inject from a secrets manager (AWS Secrets Manager / Vault) - never commit.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://amrutam:amrutam@localhost:5432/amrutam
# DATABASE_REPLICA_URL=postgres://...read-replica
# REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-32+-char-random-string
# 32-byte base64 keys:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYRING=v1:REPLACE_WITH_BASE64_32_BYTES
ACTIVE_KEY_VERSION=v1
LOG_LEVEL=info
OTEL_ENABLED=false
