{ "title": "Amrutam API - RED & Business", "schemaVersion": 39, "refresh": "15s",
  "panels": [
    { "type": "timeseries", "title": "Request rate by route", "gridPos": {"x":0,"y":0,"w":12,"h":8}, "targets": [{ "expr": "sum by (route) (rate(http_request_duration_seconds_count[1m]))" }] },
    { "type": "timeseries", "title": "p95 latency (reads)", "gridPos": {"x":12,"y":0,"w":12,"h":8}, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le,route) (rate(http_request_duration_seconds_bucket{method=\"GET\"}[5m])))" }] },
    { "type": "timeseries", "title": "p95 latency (writes)", "gridPos": {"x":0,"y":8,"w":12,"h":8}, "targets": [{ "expr": "histogram_quantile(0.95, sum by (le,route) (rate(http_request_duration_seconds_bucket{method=~\"POST|PATCH|DELETE\"}[5m])))" }] },
    { "type": "timeseries", "title": "5xx error ratio", "gridPos": {"x":12,"y":8,"w":12,"h":8}, "targets": [{ "expr": "sum(rate(http_request_duration_seconds_count{status=~\"5..\"}[5m])) / sum(rate(http_request_duration_seconds_count[5m]))" }] },
    { "type": "timeseries", "title": "Bookings by outcome", "gridPos": {"x":0,"y":16,"w":8,"h":8}, "targets": [{ "expr": "sum by (outcome) (rate(bookings_total[5m]))" }] },
    { "type": "timeseries", "title": "Payments by outcome", "gridPos": {"x":8,"y":16,"w":8,"h":8}, "targets": [{ "expr": "sum by (outcome) (rate(payments_total[5m]))" }] },
    { "type": "stat", "title": "Outbox backlog", "gridPos": {"x":16,"y":16,"w":8,"h":8}, "targets": [{ "expr": "outbox_pending" }] }
  ] }
